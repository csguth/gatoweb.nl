<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-written (Hugo's own sitemap output is disabled in hugo.toml) so it can carry
     the __SITE_URL__ placeholder that the deploy workflows substitute per environment.
     One entry per language page, each declaring every language as an xhtml:link
     alternate, plus x-default pointing at the root language-picking redirect. -->
<urlset xmlns="http://www.sitemaps.org/schemas/sitemap/0.9" xmlns:xhtml="http://www.w3.org/1999/xhtml">
  <url>
    <loc>__SITE_URL__/en/</loc>
    <xhtml:link rel="alternate" hreflang="en" href="__SITE_URL__/en/"/>
    <xhtml:link rel="alternate" hreflang="nl" href="__SITE_URL__/nl/"/>
    <xhtml:link rel="alternate" hreflang="pt" href="__SITE_URL__/pt/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="__SITE_URL__/"/>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>__SITE_URL__/nl/</loc>
    <xhtml:link rel="alternate" hreflang="en" href="__SITE_URL__/en/"/>
    <xhtml:link rel="alternate" hreflang="nl" href="__SITE_URL__/nl/"/>
    <xhtml:link rel="alternate" hreflang="pt" href="__SITE_URL__/pt/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="__SITE_URL__/"/>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
  <url>
    <loc>__SITE_URL__/pt/</loc>
    <xhtml:link rel="alternate" hreflang="en" href="__SITE_URL__/en/"/>
    <xhtml:link rel="alternate" hreflang="nl" href="__SITE_URL__/nl/"/>
    <xhtml:link rel="alternate" hreflang="pt" href="__SITE_URL__/pt/"/>
    <xhtml:link rel="alternate" hreflang="x-default" href="__SITE_URL__/"/>
    <changefreq>weekly</changefreq>
    <priority>1.0</priority>
  </url>
</urlset>
